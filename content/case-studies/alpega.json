  "intro": {
    "title": "Alpega",
    "subtitle": "Same symbol, sharper brand.",
    "copy": "Not every brand needs to start again. Alpega already had a recognisable symbol; what it needed was a stronger visual language around it. We refined the existing mark and gave its triangular geometry a more active role. The triangle became a device for framing photography, structuring layouts and directing attention. A considered evolution that made more of what the brand already owned.",
    "services": [
      "Brand Evolution",
      "Symbol Refinement",
      "Visual Language",
      "Layout System",
      "Art Direction"
    ]
  },
  "blocks": [
    {
      "image": {
        "src": "/media/alpega/alpega-challenge.webp",
        "alt": "Alpega brand before the evolution"
      },
      "title": "Alpega",
      "subtitle": "The challenge",
      "copy": "Alpega did not need another identity. It needed a sharper expression of the one it already had.\n\nThe challenge was to modernise the brand without losing recognition—and to move beyond the predictable visual codes of logistics.\n\nEvery change needed to create progress without erasing familiarity. New, but unmistakably Alpega.",
      "_template": "imageTextLeft"
    },
    {
      "image": {
        "src": "/media/alpega/alpine-2.webp",
        "alt": "Alpine 2"
      },
      "_template": "oneImage"
    },
    {
      "leftText": "The solution",
      "rightText": "The triangle was already central to Alpega. We gave it a more purposeful role.\n\nMoving beyond repetition and decorative collage, it became a system for framing imagery, shaping layouts and guiding attention. What was once a familiar motif became a sophisticated design principle—clearer, more distinctive and built to scale.",
      "_template": "twoText"
    },
