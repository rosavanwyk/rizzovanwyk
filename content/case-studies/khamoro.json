  "navigationLogo": "/media/khamoro/khamoro.svg",
  "heroImage": {
    "src": "/media/khamoro/b1.webp",
    "alt": "Khamoro case study panel B1"
  },
  "intro": {
    "copy": "Khamoro means sun in Romani. For Prague's World Roma Festival, we wanted an identity that expressed the richness and movement of the culture itself. Inspired by the folds, forms and rhythm of traditional Romani dress, we redrew the festival's lettering into a distinctive visual language. Individual characters become patterns, compositions and bold graphic statements. A system that can change endlessly without losing its identity.",
    "title": "Khamoro",
    "subtitle": "An identity drawn from Romani dress."
  },
  "blocks": [
    {
      "_template": "imageTextRight",
      "image": {
        "src": "/media/khamoro/khamoro-2.webp",
        "alt": "Khamoro 2"
      },
      "title": "Khamoro 2026",
      "subtitle": "The Logotype",
      "copy": "The Khamoro logotype takes inspiration from the movement, volume and flowing silhouettes found in Romani dress and performance. Folds and curves are abstracted into custom letterforms, connecting the identity to its cultural context without relying on literal symbols."
    },
