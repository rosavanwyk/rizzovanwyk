  "intro": {
    "title": "Bird",
    "subtitle": "From simple shapes to endless expression.",
    "copy": "Bird is a self-initiated exploration of the possibilities hidden in simple geometry. Free from a fixed meaning or function, its shapes move between graphic design and physical objects, becoming prints, textiles, lighting and games.\n\nAn open-ended visual system designed to move beyond the screen and into the physical world. We're looking for the right production partner to bring it to life.",
    "services": [
      "Branding",
      "Illustration",
      "Geometry ",
      "Product"
    ]
  },
