  "intro": {
    "title": "Fichap",
    "subtitle": "A brand that grew with the company.",
    "copy": "Startups change. Their brands need to keep up. Having designed Fichap's identity through several stages of its development, Martin brought those iterations together into a more cohesive, mature visual system. A small dot within the symbol became the starting point for an adaptable graphic language, extending naturally across communications and the digital product. An identity built to support the business as it grows.",
    "services": [
      "Brand Evolution",
      "Graphic Language",
      "Colour & Gradient System ",
      "Data Visualisation"
    ]
  },
